# ─────────────────────────────────────────────────────────────────────────────
# knowDeX — Environment Variables Template
# Copy this file to .env and fill in the values.
# .env is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production-32-chars!!

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/academic_assistant

# ── OpenRouter AI ─────────────────────────────────────────────────────────────
# Required for: summaries, RAG chat, quiz generation, flashcards, concept extraction.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── ChromaDB (vector store) ───────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=academic_documents

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# ── Text Chunking ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── RAG Retrieval ─────────────────────────────────────────────────────────────
RETRIEVAL_K=5
